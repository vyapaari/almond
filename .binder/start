#!/bin/bash
echo "🚀 Starting Multi-Service Environment..."

# Start VS Code on port 8090 in background
echo "Starting VS Code on port 8090..."
code-server --auth none --bind-addr 0.0.0.0:8090 /home/jovyan/workspace > /tmp/code-server.log 2>&1 &

# Start JupyterLab (original Binder command)
echo "Starting JupyterLab..."
exec "$@" &

echo "✅ Both services starting..."
echo "JupyterLab: will be available at main URL"
echo "VS Code: will be available at /proxy/8090/"

# Keep container alive
wait